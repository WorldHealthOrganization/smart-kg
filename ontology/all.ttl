sgkg:hasComponent_DigitalAdaptationKit_DecisionSupportLogic a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:hasComponent ;
  rdfs:domain sgkg:DigitalAdaptationKit ;
  rdfs:range sgkg:DecisionSupportLogic ;
  skos:note "qualifier: decisionLogic" ;
  rdfs:label "Digital Adaptation Kit decisionLogic Decision-Support Logic" .

sgkg:hasComponent_DigitalAdaptationKit_ProgramIndicator a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:hasComponent ;
  rdfs:domain sgkg:DigitalAdaptationKit ;
  rdfs:range sgkg:ProgramIndicator ;
