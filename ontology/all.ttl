sgkg:hasComponent_DigitalAdaptationKit_NonFunctionalRequirement a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:hasComponent ;
  rdfs:domain sgkg:DigitalAdaptationKit ;
  rdfs:range sgkg:NonFunctionalRequirement ;
