  rdfs:domain sgkg:DigitalAdaptationKit ;
  rdfs:range sgkg:HealthIntervention ;
  skos:note "qualifier: healthInterventions" ;
  rdfs:label "Digital Adaptation Kit healthInterventions Health intervention" .

sgkg:hasComponent_DigitalAdaptationKit_GenericPersona a owl:ObjectProperty ;
