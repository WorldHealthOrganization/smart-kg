sgkg:hasComponent_DigitalAdaptationKit_TestScenario a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:hasComponent ;
  rdfs:domain sgkg:DigitalAdaptationKit ;
  rdfs:range sgkg:TestScenario ;
