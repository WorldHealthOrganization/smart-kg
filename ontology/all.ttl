  rdfs:label "Digital Adaptation Kit testScenarios Test Scenario" .

sgkg:hasComponent_DigitalAdaptationKit_SchedulingLogic a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:hasComponent ;
