sgkg:hasComponent_DigitalAdaptationKit_UserScenario a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:hasComponent ;
  rdfs:domain sgkg:DigitalAdaptationKit ;
  rdfs:range sgkg:UserScenario ;
  skos:note "qualifier: userScenarios" ;
  rdfs:label "Digital Adaptation Kit userScenarios User Scenario" .

sgkg:hasComponent_DigitalAdaptationKit_BusinessProcessWorkflow a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:hasComponent ;
  rdfs:domain sgkg:DigitalAdaptationKit ;
  rdfs:range sgkg:BusinessProcessWorkflow ;
  skos:note "qualifier: businessProcesses" ;
  rdfs:label "Digital Adaptation Kit businessProcesses Business Process Workflow" .

sgkg:hasComponent_DigitalAdaptationKit_CoreDataElement a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:hasComponent ;
  rdfs:domain sgkg:DigitalAdaptationKit ;
  rdfs:range sgkg:CoreDataElement ;
  skos:note "qualifier: dataElements" ;
