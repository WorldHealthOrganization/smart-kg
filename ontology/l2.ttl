sgkg:performedBy_ProcessParticipant_Persona a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:performedBy ;
  rdfs:domain sgkg:ProcessParticipant ;
  rdfs:range sgkg:Persona ;
  rdfs:label "Process Participant performedBy Persona" .

sgkg:invokedBy_DecisionTable_ProcessTask a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:invokedBy ;
  rdfs:domain sgkg:DecisionTable ;
  rdfs:range sgkg:ProcessTask ;
  rdfs:label "Decision Table invokedBy Process Task" .

sgkg:invokedBy_DecisionTable_ExternalArtefact a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:invokedBy ;
  rdfs:domain sgkg:DecisionTable ;
  rdfs:range sgkg:ExternalArtefact ;
  rdfs:label "Decision Table invokedBy External artefact" .

sgkg:reads_InputClause_DataElement a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:reads ;
  rdfs:domain sgkg:InputClause ;
  rdfs:range sgkg:DataElement ;
  rdfs:label "Input Clause reads Data Element" .

sgkg:citesSource_DecisionRule_Citation a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:citesSource ;
  rdfs:domain sgkg:DecisionRule ;
  rdfs:range sgkg:Citation ;
  rdfs:label "Decision Rule citesSource Citation" .

sgkg:definedBy_DataElement_ExternalArtefact a owl:ObjectProperty ;
