sgkg:crossReferences_DataElement_TerminologyCode a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:crossReferences ;
  rdfs:domain sgkg:DataElement ;
  rdfs:range sgkg:TerminologyCode ;
