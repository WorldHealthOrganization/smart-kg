{
  "@context": {
    "@version": 1.1,
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "dcterms": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "sgkg": "http://smart.who.int/kg/",
    "id": "@id",
    "type": "@type",
    "label": {
      "@id": "rdfs:label"
    },
    "properties": {
      "@id": "sgkg:properties",
      "@container": "@index"
    },
    "nodes": {
      "@id": "sgkg:node",
      "@container": "@set"
    },
    "edges": {
      "@id": "sgkg:edge",
      "@container": "@set"
    },
    "Statement": "rdf:Statement",
    "Entity": "prov:Entity",
    "predicate": {
      "@id": "rdf:predicate",
      "@type": "@vocab"
    },
    "source": {
      "@id": "rdf:subject",
      "@type": "@id"
    },
    "target": {
      "@id": "rdf:object",
      "@type": "@id"
    },
    "qualifier": {
      "@id": "sgkg:qualifier"
    },
    "derivation": {
      "@id": "sgkg:derivation"
    },
    "evidence": {
      "@id": "sgkg:evidence"
    },
    "location": {
      "@id": "sgkg:location"
    },
    "quote": {
      "@id": "sgkg:quote"
    },
    "note": {
      "@id": "skos:note"
    },
    "skill": {
      "@id": "sgkg:skill"
    },
    "generatedAt": {
      "@id": "prov:generatedAtTime",
      "@type": "xsd:dateTime"
    },
    "wasDerivedFrom": {
      "@id": "prov:wasDerivedFrom",
      "@type": "@id"
    },
    "ontologyVersion": {
      "@id": "sgkg:ontologyVersion"
    },
    "contains": {
      "@id": "sgkg:contains"
    },
    "hasSupplement": {
      "@id": "sgkg:hasSupplement"
    },
    "supersedes": {
      "@id": "sgkg:supersedes"
    },
    "refines": {
      "@id": "sgkg:refines"
    },
    "restates": {
      "@id": "sgkg:restates"
    },
    "answers": {
      "@id": "sgkg:answers"
    },
    "addresses": {
      "@id": "sgkg:addresses"
    },
    "aboutIntervention": {
      "@id": "sgkg:aboutIntervention"
    },
    "reportedIn": {
      "@id": "sgkg:reportedIn"
    },
    "supportedBy": {
      "@id": "sgkg:supportedBy"
    },
    "hasRemark": {
      "@id": "sgkg:hasRemark"
    },
    "recommends": {
      "@id": "sgkg:recommends"
    },
    "definedIn": {
      "@id": "sgkg:definedIn"
    },
    "schedules": {
      "@id": "sgkg:schedules"
    },
    "measures": {
      "@id": "sgkg:measures"
    },
    "derivedFrom": {
      "@id": "sgkg:derivedFrom"
    },
    "crossReferences": {
      "@id": "sgkg:crossReferences"
    },
    "classifiedAs": {
      "@id": "sgkg:classifiedAs"
    },
    "appearsIn": {
      "@id": "sgkg:appearsIn"
    },
    "resolvesTo": {
      "@id": "sgkg:resolvesTo"
    },
    "implementedBy": {
      "@id": "sgkg:implementedBy"
    },
    "Publication": "sgkg:publication",
    "PublicationSection": "sgkg:publication-section",
    "Recommendation": "sgkg:recommendation",
    "Remark": "sgkg:remark",
    "KeyQuestion": "sgkg:key-question",
    "Evidence": "sgkg:evidence",
    "HealthIntervention": "sgkg:health-intervention",
    "Schedule": "sgkg:schedule",
    "ScheduleEntry": "sgkg:schedule-entry",
    "Indicator": "sgkg:indicator",
    "TerminologyCode": "sgkg:terminology-code",
    "Citation": "sgkg:citation",
    "ExternalArtefact": "sgkg:external-artifact"
  }
}
